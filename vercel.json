{
  "version": 2,
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/frontend/build/index.html"
    }
  ]
}